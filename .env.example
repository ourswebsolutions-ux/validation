# ─── WhatsApp session ────────────────────────────────────────────────
# Directory where Baileys stores the linked-device session (server-side only).
# Must be OUTSIDE /public. Relative paths resolve from the project root.
WA_AUTH_DIR=./.wa-session

# Server log level: fatal | error | warn | info | debug
LOG_LEVEL=warn

# ─── Checking rate (conservative defaults — do not make these aggressive) ─
# Numbers sent to WhatsApp in one lookup query.
CHECK_BATCH_SIZE=5
# Minimum pause between two lookup queries, in milliseconds.
CHECK_INTERVAL_MS=3000
# Timeout for a single lookup query, in milliseconds.
CHECK_TIMEOUT_MS=20000
# How long the server re-uses a previous result for the same number (ms). 0 disables.
CHECK_CACHE_TTL_MS=3600000

# ─── Request limits ─────────────────────────────────────────────────
# Maximum numbers accepted per bulk job request (larger lists are split into several jobs).
MAX_NUMBERS_PER_REQUEST=500
# Maximum simultaneously queued/running bulk jobs per client IP, and in total.
MAX_JOBS_PER_CLIENT=2
MAX_JOBS_TOTAL=20

# ─── API rate limiting (requests per minute, per client IP) ───────────
RATE_LIMIT_SINGLE_PER_MIN=20
RATE_LIMIT_JOBS_PER_MIN=10
RATE_LIMIT_READ_PER_MIN=240

# Set to true ONLY when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# ─── Access protection (strongly recommended on any public deployment) ─
# When both are set, the whole site and API require HTTP Basic authentication.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# ─── Public (browser) settings — never put secrets in NEXT_PUBLIC_* ────
# Max CSV upload size in megabytes and max numbers per list.
NEXT_PUBLIC_MAX_CSV_MB=5
NEXT_PUBLIC_MAX_NUMBERS=20000
# Hours before temporary browser data is wiped automatically.
NEXT_PUBLIC_SESSION_TTL_HOURS=24
